<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A1C1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Widgets</item>
    </style>

    <style name="Theme.Widgets" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorPrimaryContainer">@color/purple_700</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="android:statusBarColor">@color/status_bar_default</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Widgets.Ocean" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorPrimaryContainer">@color/ocean_primary</item>
        <item name="colorOnPrimary">#121212</item>
        <item name="colorOnPrimaryContainer">#121212</item>
        <item name="android:statusBarColor">@color/status_bar_ocean</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Widgets.Emerald" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/emerald_primary</item>
        <item name="colorSecondary">@color/emerald_secondary</item>
        <item name="colorPrimaryContainer">@color/emerald_primary</item>
        <item name="colorOnPrimary">#121212</item>
        <item name="colorOnPrimaryContainer">#121212</item>
        <item name="android:statusBarColor">@color/status_bar_emerald</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
